# ─── HMS Environment Variables ───
# Copy to .env and fill in real values. NEVER commit .env.
# See docs/02-foundation-spec.md for full documentation.

# Node environment: development | test | production
NODE_ENV=development

# API server port
PORT=3000

# Frontend origin (for CORS and Origin header checks)
APP_ORIGIN=http://localhost:5173

# ─── Database ───
# Runtime connection (hms_app role, least-privilege)
DATABASE_URL=postgresql://hms_app:dev_app_pass@localhost:5432/hms_dev
# Migration connection (hms_owner role, schema owner)
DATABASE_MIGRATION_URL=postgresql://hms_owner:dev_owner_pass@localhost:5432/hms_dev
# Prisma shadow database for migrate dev (hms_owner role)
SHADOW_DATABASE_URL=postgresql://hms_owner:dev_owner_pass@localhost:5432/hms_shadow

# ─── Test Database ───
# Automated test connections (mapped to DATABASE_URL / DATABASE_MIGRATION_URL by Jest)
TEST_DATABASE_URL=postgresql://hms_app:dev_app_pass@localhost:5432/hms_test
TEST_DATABASE_MIGRATION_URL=postgresql://hms_owner:dev_owner_pass@localhost:5432/hms_test

# ─── Password Hashing (Argon2id) ───
# Defaults match RFC 9106 second recommended profile; prod/dev floor enforced at 19456 KiB
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# ─── Docker PostgreSQL passwords (used by docker-compose.yml) ───
POSTGRES_SUPERUSER_PASSWORD=dev_super_pass
HMS_OWNER_PASSWORD=dev_owner_pass
HMS_APP_PASSWORD=dev_app_pass

# ─── Session ───
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=12

# ─── Login security ───
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ─── Cookie ───
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false

# ─── Logging ───
# Levels: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ─── Hospital ───
HOSPITAL_TIMEZONE=UTC
DEFAULT_LOCALE=en

# ─── OpenAPI / Swagger Documentation ───
# Expose Swagger UI at /api/docs (development only; defaults to false when unset)
SWAGGER_ENABLED=false

# ─── Rate Limiting (Throttler) ───
# Window size in milliseconds
THROTTLE_TTL_MS=60000
# Maximum number of requests per window
THROTTLE_LIMIT=100
# Strict rate limiting for authentication endpoints (/auth/login, /auth/change-password)
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_MS=60000

# ─── Argon2 Limiter & Queue ───
# Maximum concurrent Argon2 operations (default: 2, preserves libuv worker pool)
ARGON2_MAX_CONCURRENCY=2
# Maximum queued requests before immediate 503 fast-fail
ARGON2_MAX_QUEUE=50
# Maximum wait timeout in milliseconds for queued Argon2 operations
ARGON2_QUEUE_TIMEOUT_MS=10000

# ─── Reverse Proxy & Trust Proxy ───
# Number of reverse proxy hops to trust for X-Forwarded-For client IP (0 = off / direct connection)
# MUST be set to the proxy hop count (typically 1) when deployed behind Nginx/Caddy/Traefik
TRUST_PROXY=0
