# ─── HMS Environment Variables ───
# Copy to .env and fill in real values. NEVER commit .env.
# See docs/02-foundation-spec.md for full documentation.

# Node environment: development | test | production
NODE_ENV=development

# API server port
PORT=3000

# Frontend origin (for CORS and Origin header checks)
APP_ORIGIN=http://localhost:5173

# ─── Database ───
# Runtime connection (hms_app role, least-privilege)
DATABASE_URL=postgresql://hms_app:CHANGE_ME_APP@localhost:5432/hms_dev
# Migration connection (hms_owner role, schema owner)
DATABASE_MIGRATION_URL=postgresql://hms_owner:CHANGE_ME_OWNER@localhost:5432/hms_dev

# ─── Docker PostgreSQL passwords (used by docker-compose.yml) ───
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_SUPER
HMS_OWNER_PASSWORD=CHANGE_ME_OWNER
HMS_APP_PASSWORD=CHANGE_ME_APP

# ─── Session ───
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=12

# ─── Login security ───
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ─── Cookie ───
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false

# ─── Logging ───
LOG_LEVEL=info

# ─── Hospital ───
HOSPITAL_TIMEZONE=UTC
DEFAULT_LOCALE=en
